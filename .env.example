# Contraseña del panel /admin (OBLIGATORIA en producción)
TECHDEV_PASSWORD=cambia-esta-clave

# Secreto para firmar la cookie de sesión (opcional, se deriva de la contraseña si falta)
# TECHDEV_SESSION_SECRET=una-cadena-larga-y-aleatoria

# URL pública usada en meta tags, sitemap y robots.txt
APP_BASE_URL=http://localhost:8000

# Rutas dentro del contenedor (no cambiar salvo que sepas lo que haces)
# TECHDEV_DB_PATH=/app/data/app.db
# TECHDEV_UPLOAD_DIR=/app/data/uploads
